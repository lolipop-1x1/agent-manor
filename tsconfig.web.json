{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["web/**/*.ts", "web/**/*.tsx", "src/contracts.ts", "src/version.ts", "vite.config.ts"]
}
