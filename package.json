{
  "name": "agent-manor",
  "version": "0.1.0",
  "description": "本地优先的 Agent 历史与仓库代码活动分析工具",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "bin": {
    "agent-manor": "dist/cli.js",
    "am": "dist/cli.js"
  },
  "files": [
    "dist/",
    "skills/",
    "docs/usage.md",
    "docs/assets/readme/agent-manor-banner-sketch-garden-wide.png",
    "site/public/previews/sessions-zh.png",
    "site/public/previews/knowledge-zh.png",
    "site/public/previews/overview-zh.png",
    "site/public/previews/code-map-zh.png",
    "site/public/previews/replay-zh.png",
    "site/public/previews/usage-zh.png",
    "site/public/previews/resources-zh.png",
    "site/public/previews/sessions-en.png",
    "site/public/previews/knowledge-en.png",
    "site/public/previews/overview-en.png",
    "site/public/previews/code-map-en.png",
    "site/public/previews/replay-en.png",
    "site/public/previews/usage-en.png",
    "site/public/previews/resources-en.png",
    "docs/agents/public-content.md",
    "docs/design/history-support.md",
    "docs/design/native-client-sources.md",
    "docs/design/doubao-work-sources.md",
    "docs/validation/doubao-work.md",
    "docs/design/baseline-rules.md",
    "docs/design/matching-rules.md",
    "docs/design/session-history.md",
    "docs/design/session-code-replay.md",
    "docs/design/session-import-performance.md",
    "docs/design/usage-statistics.md",
    "docs/design/overview-dashboard.md",
    "docs/design/resource-support.md",
    "docs/design/codeflicker-resource-sources.md",
    "docs/design/resource-history-parsing.md",
    "docs/design/semantic-search.md",
    "docs/validation/semantic-search.md",
    "docs/design/knowledge-library.md",
    "docs/validation/knowledge-library.md",
    "docs/validation/npm-cli-distribution.md",
    "docs/validation/software-updates.md",
    "docs/design/cli-responses.md"
  ],
  "scripts": {
    "check:public": "node scripts/check-public-content.mjs",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json && node scripts/package-entries.mjs",
    "build:web": "vite build",
    "build:site": "vite build --config site/vite.config.ts",
    "dev:site": "vite --config site/vite.config.ts",
    "preview:site": "vite preview --config site/vite.config.ts",
    "check:site": "tsc -p tsconfig.site.json",
    "capture:site": "npm run build && node scripts/capture-site-previews.mjs",
    "test:site": "node --import tsx --test tests/site-*.test.ts",
    "test:site:e2e": "node scripts/e2e-site.mjs",
    "check": "npm run check:i18n && npm run check:server && npm run check:web",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "check:web": "tsc -p tsconfig.web.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:sqlite": "node scripts/check-sqlite.mjs",
    "dev:web": "vite",
    "prepack": "npm run check:public && npm run build && node scripts/check-package.mjs",
    "check:i18n": "node --import tsx scripts/check-i18n.mjs",
    "check:cli": "npm run check --workspace @agent-manor/cli",
    "test:cli": "npm run test --workspace @agent-manor/cli",
    "test:package": "node scripts/test-installed-package.mjs",
    "test:cli:installed": "node scripts/e2e-npm-cli.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "better-sqlite3": "13.0.3",
    "commander": "15.0.0",
    "diff": "9.0.0",
    "fastify": "5.12.5",
    "i18next": "26.4.2",
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5",
    "smol-toml": "1.9.0",
    "sqlite-vec": "0.1.9",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.1",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "@types/better-sqlite3": "9.6.0",
    "@types/d3": "7.4.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "cmdk": "1.1.1",
    "codemirror": "6.0.2",
    "d3": "7.9.0",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vite": "8.3.2"
  },
  "workspaces": [
    "packages/cli"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lolipop-1x1/agent-manor.git"
  },
  "homepage": "https://github.com/lolipop-1x1/agent-manor#readme",
  "bugs": {
    "url": "https://github.com/lolipop-1x1/agent-manor/issues"
  },
  "keywords": [
    "agent",
    "cli",
    "local-first",
    "session-history",
    "knowledge"
  ]
}
